# Copy to .env (never commit it) and fill in. README.md in this folder explains each step.

# The demo's host name: your own domain, or <public IP with dashes>.sslip.io (a-b-c-d.sslip.io for the address a.b.c.d)
CEDARS_DOMAIN=

# Make each with: openssl rand -base64 48 | tr -d '\n/+='
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# A demo's address changes; keep browsers from pinning HTTPS to it for a year
DJANGO_HSTS_SECONDS=3600

# Optional: send email through an SMTP server (e.g. Amazon SES). Left blank, emails are printed to `docker compose logs web`.
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Folder on the server that holds files to import (legacy downloads, reference data); mounted read-only at /import
CEDARS_IMPORT_DIR=./import
